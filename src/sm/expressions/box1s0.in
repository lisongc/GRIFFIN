// log(1-s/s0) terms for one-loop box diagrams; implemented by adding
// terms with [log(1-s/s0)-log(1-s/mz^2)] to the case for arbitrary s
Cplx B1s0(Fermion it, Fermion ot, Current if1, Current of1, double s, double cost, const inval& input)
{
  double MZs = sqr(input.get(InputPar::ZMassComplex)),
         MWs = sqr(input.get(InputPar::WMassComplex)),
         MTs = sqr(input.get(InputPar::topMass)),
         AL = input.get(InputPar::alpha),
         MIs, MFs;
  Cplx s0 = MZs - I*input.get(InputPar::ZMassComplex)*input.get(InputPar::ZWidthComplex),
       res = 0;
  if(it==Fermion::b)
    MIs = MTs;
  else
    MIs = 0;
  if(ot==Fermion::b)
    MFs = MTs;
  else
    MFs = 0;
  switch(if1) {
   case Current::scalar:
   case Current::pseudoscalar:
    break;
   case Current::vector:
    switch(of1) {
     case Current::scalar:
     case Current::pseudoscalar:
      break;
     case Current::vector:
      res = (4*(-clog2(1 - s/MZs) + log(1 - s/s0))*Qf[index(it)]*Qf[index(ot)]*((MWs - MZs)*(2*cost*log(2/(1 + cost)) - (-1 + cost)*log((1 - cost)/(1 + cost)))*Qf[index(it)]*(MZs*I3f[index(ot)] + 2*(MWs - MZs)*Qf[index(ot)]) + MZs*I3f[index(it)]*((-1 + cost)*MZs*(log(2/(1 + cost)) - log((1 - cost)/(1 + cost)))*I3f[index(ot)] + (MWs - MZs)*(2*cost*log(2/(1 + cost)) - (-1 + cost)*log((1 - cost)/(1 + cost)))*Qf[index(ot)])))/((-1 + cost)*(1 + cost)*MWs*(MWs - MZs)*MZs);
      break;
     case Current::axial:
      res = (4*(-clog2(1 - s/MZs) + log(1 - s/s0))*Qf[index(it)]*Qf[index(ot)]*((MWs - MZs)*(2*cost*log(2/(1 + cost)) - (-1 + cost)*log((1 - cost)/(1 + cost)))*I3f[index(ot)]*Qf[index(it)] + I3f[index(it)]*((-1 + cost)*MZs*(log(2/(1 + cost)) - log((1 - cost)/(1 + cost)))*I3f[index(ot)] - (MWs - MZs)*(2*log(2/(1 + cost)) + (-1 + cost)*log((1 - cost)/(1 + cost)))*Qf[index(ot)])))/((-1 + cost)*(1 + cost)*MWs*(MWs - MZs));
      break;
    }
    break;
   case Current::axial:
    switch(of1) {
     case Current::scalar:
     case Current::pseudoscalar:
      break;
     case Current::vector:
      res = (4*(-clog2(1 - s/MZs) + log(1 - s/s0))*Qf[index(it)]*Qf[index(ot)]*(-((MWs - MZs)*(2*log(2/(1 + cost)) + (-1 + cost)*log((1 - cost)/(1 + cost)))*I3f[index(ot)]*Qf[index(it)]) + I3f[index(it)]*((-1 + cost)*MZs*(log(2/(1 + cost)) - log((1 - cost)/(1 + cost)))*I3f[index(ot)] + (MWs - MZs)*(2*cost*log(2/(1 + cost)) - (-1 + cost)*log((1 - cost)/(1 + cost)))*Qf[index(ot)])))/((-1 + cost)*(1 + cost)*MWs*(MWs - MZs));
      break;
     case Current::axial:
      res = (4*(-clog2(1 - s/MZs) + log(1 - s/s0))*Qf[index(it)]*Qf[index(ot)]*(-((MWs - MZs)*(2*log(2/(1 + cost)) + (-1 + cost)*log((1 - cost)/(1 + cost)))*Qf[index(it)]*(MZs*I3f[index(ot)] + 2*(MWs - MZs)*Qf[index(ot)])) + MZs*I3f[index(it)]*((-1 + cost)*MZs*(log(2/(1 + cost)) - log((1 - cost)/(1 + cost)))*I3f[index(ot)] - (MWs - MZs)*(2*log(2/(1 + cost)) + (-1 + cost)*log((1 - cost)/(1 + cost)))*Qf[index(ot)])))/((-1 + cost)*(1 + cost)*MWs*(MWs - MZs)*MZs);
    }
    break;
  }
  return(res*sqr(AL));
}

