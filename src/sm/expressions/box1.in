// one-loop box diagrams for s=mz^2
Cplx B1(Fermion it, Fermion ot, Current if1, Current of1, double s, double cost, const inval& input, int AA, int AZ, double gzflag)
{
  double MZs = sqr(input.get(InputPar::ZMassComplex)),
         MWs = sqr(input.get(InputPar::WMassComplex)),
         MTs = sqr(input.get(InputPar::topMass)),
         AL = input.get(InputPar::alpha),
         MIs, MFs;
  Cplx s0 = MZs - gzflag*I*input.get(InputPar::ZMassComplex)*input.get(InputPar::ZWidthComplex),
       res = 0;
  if(it==Fermion::b)
    MIs = MTs;
  else
    MIs = 0;
  if(ot==Fermion::b)
    MFs = MTs;
  else
    MFs = 0;
  switch(if1) {
     default:
      break; // Scalar structures are assembled separately for Bhabha scattering.
   case Current::vector:
    switch(of1) {
     default:
      break; // Scalar structures are assembled separately for Bhabha scattering.
     case Current::vector:
      res = (-2*AZ*log(-2/(-1 + cost))*Qf[index(it)]*(MZs*I3f[index(it)] + 2*(MWs - MZs)*Qf[index(it)])*Qf[index(ot)]*(MZs*I3f[index(ot)] + 2*(MWs - MZs)*Qf[index(ot)]))/((1 + cost)*MWs*(MWs - MZs)*MZs) + (2*AZ*li2((-1 + cost)/(1 + cost))*Qf[index(it)]*Qf[index(ot)]*(MZs*I3f[index(ot)]*Qf[index(it)] + (MZs*I3f[index(it)] + 2*(MWs - MZs)*Qf[index(it)])*Qf[index(ot)]))/((-1 + cost)*MWs*MZs) + (2*AZ*li2((1 + cost)/(-1 + cost))*Qf[index(it)]*Qf[index(ot)]*(MZs*I3f[index(it)]*(MZs*I3f[index(ot)] + (MWs - MZs)*Qf[index(ot)]) + (MWs - MZs)*Qf[index(it)]*(MZs*I3f[index(ot)] + 2*(MWs - MZs)*Qf[index(ot)])))/((1 + cost)*MWs*(MWs - MZs)*MZs) - (2*AZ*B0fin(MZs,MZs,0)*Qf[index(it)]*Qf[index(ot)]*(2*cost*(MWs - MZs)*Qf[index(it)]*(MZs*I3f[index(ot)] + 2*(MWs - MZs)*Qf[index(ot)]) + MZs*I3f[index(it)]*((-1 + cost)*MZs*I3f[index(ot)] + 2*cost*(MWs - MZs)*Qf[index(ot)])))/((-1 + cost)*(1 + cost)*MWs*(MWs - MZs)*MZs) + (MZs*B0fin(MZs,MWs,MWs)*(1 + 4*I3f[index(it)]*I3f[index(ot)]))/(8.*(1 + cost)*sqr(MWs - MZs)) - (MZs*B0fin(((-1 + cost)*MZs)/2.,MFs,MIs)*(1 + 4*I3f[index(it)]*I3f[index(ot)]))/(8.*(1 + cost)*sqr(MWs - MZs)) - ((1 - cost)*MZs*(MFs + MIs - 2*MWs - cost*MZs)*C0(((-1 + cost)*MZs)/2.,0,0,MFs,MIs,MWs)*(1 + 4*I3f[index(it)]*I3f[index(ot)]))/(8.*sqr(1 + cost)*sqr(MWs - MZs)) + (MZs*C0(0,MZs,0,MFs,MWs,MWs)*(MFs + MIs - 2*MWs - cost*MZs + 4*I3f[index(it)]*I3f[index(ot)]*(MFs + MIs - 2*MWs + MZs + cost*MZs + MZs*sqr(cost))))/(8.*sqr(1 + cost)*sqr(MWs - MZs)) + (MZs*C0(0,MZs,0,MIs,MWs,MWs)*(MFs + MIs - 2*MWs - cost*MZs + 4*I3f[index(it)]*I3f[index(ot)]*(MFs + MIs - 2*MWs + MZs + cost*MZs + MZs*sqr(cost))))/(8.*sqr(1 + cost)*sqr(MWs - MZs)) + ((2*MFs + 2*MIs + MZs + cost*MZs)*D0(-((1 + cost)*MZs)/2.,0,MZs,0,0,0,MFs,MIs,MWs,MWs)*(-1 + 4*I3f[index(it)]*I3f[index(ot)])*sqr(MZs))/(32.*sqr(MWs - MZs)) - (AZ*Qf[index(it)]*Qf[index(ot)]*(2*cost*(MWs - MZs)*Qf[index(it)]*(MZs*I3f[index(ot)] + 2*(MWs - MZs)*Qf[index(ot)]) + MZs*I3f[index(it)]*((-1 + cost)*MZs*I3f[index(ot)] + 2*cost*(MWs - MZs)*Qf[index(ot)]))*sqr(Pi))/(3.*(-1 + cost)*(1 + cost)*MWs*(MWs - MZs)*MZs) - (Qf[index(it)]*Qf[index(ot)]*(2*AA*cost*MZs*Qf[index(it)]*Qf[index(ot)] - (AZ*(1 + cost)*MZs*(MZs*I3f[index(it)]*(MZs*I3f[index(ot)] + (MWs - MZs)*Qf[index(ot)]) + (MWs - MZs)*Qf[index(it)]*(MZs*I3f[index(ot)] + 2*(MWs - MZs)*Qf[index(ot)])))/(MWs*(MWs - MZs)))*sqr(log((1 - cost)/(1 + cost))))/(sqr(1 + cost)*sqr(MZs)) - (4*AA*cost*B0fin(MZs,0,0)*sqr(Qf[index(it)])*sqr(Qf[index(ot)]))/(MZs - MZs*sqr(cost)) + log((1 - cost)/(1 + cost))*((-4*AZ*log(1 - s/s0)*Qf[index(it)]*Qf[index(ot)]*(MZs*I3f[index(it)]*(MZs*I3f[index(ot)] + (MWs - MZs)*Qf[index(ot)]) + (MWs - MZs)*Qf[index(it)]*(MZs*I3f[index(ot)] + 2*(MWs - MZs)*Qf[index(ot)])))/((1 + cost)*MWs*(MWs - MZs)*MZs) - (Qf[index(it)]*Qf[index(ot)]*(2*AA*Qf[index(it)]*Qf[index(ot)] + (AZ*(MZs*I3f[index(it)] + 2*(MWs - MZs)*Qf[index(it)])*(MZs*I3f[index(ot)] + 2*(MWs - MZs)*Qf[index(ot)]))/(MWs*(MWs - MZs)) - (Cplx(0,4)*AA*Pi*Qf[index(it)]*Qf[index(ot)]*(1 + cost + sqr(cost)))/sqr(1 + cost)))/MZs - (4*AA*log(2/sqrt(1 - pow(cost,2)))*sqr(Qf[index(it)])*sqr(Qf[index(ot)]))/MZs) - (B0fin(-((1 + cost)*MZs)/2.,0,0)*(-2*MZs*((-1 + AZ)*MWs + MZs)*I3f[index(ot)]*Qf[index(ot)]*sqr(Qf[index(it)]) + sqr(MZs)*sqr(I3f[index(ot)])*sqr(Qf[index(it)]) + (-2*MZs*((-1 + AZ)*MWs + MZs)*I3f[index(it)]*Qf[index(it)] + sqr(MZs)*sqr(I3f[index(it)]) + 2*(2*(-1 + AZ)*MWs*MZs + (1 + AA - 2*AZ)*sqr(MWs) + sqr(MZs))*sqr(Qf[index(it)]))*sqr(Qf[index(ot)])))/((-1 + cost)*MZs*sqr(MWs)) + (B0fin(MZs,MZs,MZs)*(2*cost*sqr(MWs - MZs)*sqr(Qf[index(it)])*(2*(MWs - MZs)*MZs*I3f[index(ot)]*Qf[index(ot)] + sqr(MZs)*sqr(I3f[index(ot)]) + 2*sqr(MWs - MZs)*sqr(Qf[index(ot)])) + 2*(MWs - MZs)*MZs*I3f[index(it)]*Qf[index(it)]*(2*(-1 + cost)*(MWs - MZs)*MZs*I3f[index(ot)]*Qf[index(ot)] + (-1 + cost)*sqr(MZs)*sqr(I3f[index(ot)]) + 2*cost*sqr(MWs - MZs)*sqr(Qf[index(ot)])) + sqr(MZs)*sqr(I3f[index(it)])*(2*(-1 + cost)*(MWs - MZs)*MZs*I3f[index(ot)]*Qf[index(ot)] + (-1 + cost)*sqr(MZs)*sqr(I3f[index(ot)]) + 2*cost*sqr(MWs - MZs)*sqr(Qf[index(ot)]))))/(MZs*(-1 + sqr(cost))*sqr(MWs)*sqr(MWs - MZs)) + (C0(-((1 + cost)*MZs)/2.,0,0,0,0,MZs)*(-(AZ*(-1 + cost)*(1 + cost)*MWs*Qf[index(it)]*Qf[index(ot)]*(MZs*I3f[index(ot)]*Qf[index(it)] + (MZs*I3f[index(it)] + 2*(MWs - MZs)*Qf[index(it)])*Qf[index(ot)])) + (-2 - cost + sqr(cost))*(2*(MWs - MZs)*MZs*I3f[index(ot)]*Qf[index(ot)]*sqr(Qf[index(it)]) + sqr(MZs)*sqr(I3f[index(ot)])*sqr(Qf[index(it)]) + (2*(MWs - MZs)*MZs*I3f[index(it)]*Qf[index(it)] + sqr(MZs)*sqr(I3f[index(it)]) + 2*sqr(MWs - MZs)*sqr(Qf[index(it)]))*sqr(Qf[index(ot)]))))/(sqr(-1 + cost)*sqr(MWs)) + (C0(((-1 + cost)*MZs)/2.,0,0,0,0,MZs)*(AZ*(-1 + cost)*(1 + cost)*MWs*(MWs - MZs)*Qf[index(it)]*Qf[index(ot)]*(MZs*I3f[index(it)]*(MZs*I3f[index(ot)] + (MWs - MZs)*Qf[index(ot)]) + (MWs - MZs)*Qf[index(it)]*(MZs*I3f[index(ot)] + 2*(MWs - MZs)*Qf[index(ot)])) - powint(MZs,4)*(-2 + cost + sqr(cost))*(powint(MZs,-4)*sqr(MWs - MZs)*sqr(Qf[index(it)])*(2*(MWs - MZs)*MZs*I3f[index(ot)]*Qf[index(ot)] + sqr(MZs)*sqr(I3f[index(ot)]) + 2*sqr(MWs - MZs)*sqr(Qf[index(ot)])) + 2*(MWs - MZs)*I3f[index(it)]*Qf[index(it)]*powint(MZs,-3)*sqr(MZs*I3f[index(ot)] + (MWs - MZs)*Qf[index(ot)]) + sqr(I3f[index(it)])*sqr(I3f[index(ot)] + ((MWs - MZs)*Qf[index(ot)])/MZs))))/(sqr(1 + cost)*sqr(MWs)*sqr(MWs - MZs)) + (B0fin(((-1 + cost)*MZs)/2.,0,0)*(2*AZ*MWs*(MWs - MZs)*Qf[index(it)]*Qf[index(ot)]*(MZs*I3f[index(it)]*(MZs*I3f[index(ot)] + (MWs - MZs)*Qf[index(ot)]) + (MWs - MZs)*Qf[index(it)]*(MZs*I3f[index(ot)] + 2*(MWs - MZs)*Qf[index(ot)])) - powint(MZs,4)*(powint(MZs,-4)*sqr(MWs - MZs)*sqr(Qf[index(it)])*(2*(MWs - MZs)*MZs*I3f[index(ot)]*Qf[index(ot)] + sqr(MZs)*sqr(I3f[index(ot)]) + 2*(-2*MWs*MZs + (1 + AA)*sqr(MWs) + sqr(MZs))*sqr(Qf[index(ot)])) + 2*(MWs - MZs)*I3f[index(it)]*Qf[index(it)]*powint(MZs,-3)*sqr(MZs*I3f[index(ot)] + (MWs - MZs)*Qf[index(ot)]) + sqr(I3f[index(it)])*sqr(I3f[index(ot)] + ((MWs - MZs)*Qf[index(ot)])/MZs))))/((1 + cost)*MZs*sqr(MWs)*sqr(MWs - MZs)) + (Qf[index(it)]*Qf[index(ot)]*(AZ*MZs*I3f[index(it)]*((-1 + cost)*MZs*I3f[index(ot)] + 2*cost*(MWs - MZs)*Qf[index(ot)])*(-1 + sqr(cost)) + 2*cost*(MWs - MZs)*Qf[index(it)]*(AZ*MZs*I3f[index(ot)]*(-1 + sqr(cost)) - 2*Qf[index(ot)]*(-(AZ*(MWs - MZs)*(-1 + sqr(cost))) + AA*MWs*(1 + sqr(cost)))))*sqr(log(2/(1 + cost))))/(MWs*(MWs - MZs)*MZs*sqr(-1 + pow(cost,2))) + (MZs*D0(((-1 + cost)*MZs)/2.,0,MZs,0,0,0,MFs,MIs,MWs,MWs)*(1 + 4*I3f[index(it)]*I3f[index(ot)])*(-4*MWs*MZs + 8*cost*MWs*MZs - 4*MWs*MZs*sqr(cost) + 2*MIs*(2*(-3 + cost)*MWs + MZs*(2 - cost + sqr(cost))) + 2*MFs*(-2*(-1 + cost)*MIs + 2*(-3 + cost)*MWs + MZs*(2 - cost + sqr(cost))) + 4*sqr(MFs) + 4*sqr(MIs) + 12*sqr(MWs) - 4*cost*sqr(MWs) + sqr(MZs) - cost*sqr(MZs) + sqr(cost)*sqr(MZs) - sqr(MZs)*trip(cost)))/(32.*sqr(1 + cost)*sqr(MWs - MZs)) - (2*C0(0,MZs,0,0,MZs,MZs)*powint(MZs,4)*(2*cost*powint(MZs,-4)*(-3 + sqr(cost))*sqr(MWs - MZs)*sqr(Qf[index(it)])*(2*(MWs - MZs)*MZs*I3f[index(ot)]*Qf[index(ot)] + sqr(MZs)*sqr(I3f[index(ot)]) + 2*sqr(MWs - MZs)*sqr(Qf[index(ot)])) - (2*(-MWs + MZs)*I3f[index(it)]*Qf[index(it)]*((2*cost*(-3 + sqr(cost))*sqr(MWs - MZs)*sqr(Qf[index(ot)]))/sqr(MZs) + (2*(MWs - MZs)*I3f[index(ot)]*Qf[index(ot)]*(2 - 3*cost + trip(cost)))/MZs + sqr(I3f[index(ot)])*(2 - 3*cost + trip(cost))))/MZs + sqr(I3f[index(it)])*((2*cost*(-3 + sqr(cost))*sqr(MWs - MZs)*sqr(Qf[index(ot)]))/sqr(MZs) + (2*(MWs - MZs)*I3f[index(ot)]*Qf[index(ot)]*(2 - 3*cost + trip(cost)))/MZs + sqr(I3f[index(ot)])*(2 - 3*cost + trip(cost)))))/(sqr(-1 + cost)*sqr(1 + cost)*sqr(MWs)*sqr(MWs - MZs)) + log(2/(1 + cost))*((4*AZ*log(1 - s/s0)*Qf[index(it)]*Qf[index(ot)]*(2*cost*(MWs - MZs)*Qf[index(it)]*(MZs*I3f[index(ot)] + 2*(MWs - MZs)*Qf[index(ot)]) + MZs*I3f[index(it)]*((-1 + cost)*MZs*I3f[index(ot)] + 2*cost*(MWs - MZs)*Qf[index(ot)])))/((-1 + cost)*(1 + cost)*MWs*(MWs - MZs)*MZs) - (2*log((1 - cost)/(1 + cost))*Qf[index(it)]*Qf[index(ot)]*(-2*AA*cost*MZs*Qf[index(it)]*Qf[index(ot)] + (AZ*(1 + cost)*MZs*(MZs*I3f[index(it)]*(MZs*I3f[index(ot)] + (MWs - MZs)*Qf[index(ot)]) + (MWs - MZs)*Qf[index(it)]*(MZs*I3f[index(ot)] + 2*(MWs - MZs)*Qf[index(ot)])))/(MWs*(MWs - MZs))))/(sqr(1 + cost)*sqr(MZs)) + (2*Qf[index(it)]*Qf[index(ot)]*(-((AZ*(MZs*I3f[index(it)] + 2*(MWs - MZs)*Qf[index(it)])*(MZs*I3f[index(ot)] + 2*(MWs - MZs)*Qf[index(ot)]))/((-1 + cost)*MWs*(MWs - MZs))) + (Cplx(0,4)*AA*Pi*Qf[index(it)]*Qf[index(ot)]*(cost + trip(cost)))/sqr(-1 + pow(cost,2))))/MZs) - (D0(-((1 + cost)*MZs)/2.,0,MZs,0,0,0,0,0,MZs,MZs)*powint(MZs,5)*(2*powint(MZs,-4)*sqr(MWs - MZs)*sqr(Qf[index(it)])*(2*(MWs - MZs)*MZs*I3f[index(ot)]*Qf[index(ot)] + sqr(MZs)*sqr(I3f[index(ot)]) + 2*sqr(MWs - MZs)*sqr(Qf[index(ot)]))*(5 - 2*cost - 2*sqr(cost) + trip(cost)) - (2*(-MWs + MZs)*I3f[index(it)]*Qf[index(it)]*((2*(1 + cost)*(MWs - MZs)*I3f[index(ot)]*Qf[index(ot)]*sqr(-1 + cost))/MZs + (1 + cost)*sqr(-1 + cost)*sqr(I3f[index(ot)]) + (2*sqr(MWs - MZs)*sqr(Qf[index(ot)])*(5 - 2*cost - 2*sqr(cost) + trip(cost)))/sqr(MZs)))/MZs + sqr(I3f[index(it)])*((2*(1 + cost)*(MWs - MZs)*I3f[index(ot)]*Qf[index(ot)]*sqr(-1 + cost))/MZs + (1 + cost)*sqr(-1 + cost)*sqr(I3f[index(ot)]) + (2*sqr(MWs - MZs)*sqr(Qf[index(ot)])*(5 - 2*cost - 2*sqr(cost) + trip(cost)))/sqr(MZs))))/(4.*sqr(-1 + cost)*sqr(MWs)*sqr(MWs - MZs)) - (D0(((-1 + cost)*MZs)/2.,0,MZs,0,0,0,0,0,MZs,MZs)*powint(MZs,5)*(2*powint(MZs,-4)*sqr(MWs - MZs)*sqr(Qf[index(it)])*(2*(MWs - MZs)*MZs*I3f[index(ot)]*Qf[index(ot)] + sqr(MZs)*sqr(I3f[index(ot)]) + 2*sqr(MWs - MZs)*sqr(Qf[index(ot)]))*(-5 - 2*cost + 2*sqr(cost) + trip(cost)) - (2*(-MWs + MZs)*I3f[index(it)]*Qf[index(it)]*((2*sqr(MWs - MZs)*sqr(Qf[index(ot)])*(-5 - 2*cost + 2*sqr(cost) + trip(cost)))/sqr(MZs) + (2*(MWs - MZs)*I3f[index(ot)]*Qf[index(ot)]*(-9 - 3*cost + 3*sqr(cost) + trip(cost)))/MZs + sqr(I3f[index(ot)])*(-9 - 3*cost + 3*sqr(cost) + trip(cost))))/MZs + sqr(I3f[index(it)])*((2*sqr(MWs - MZs)*sqr(Qf[index(ot)])*(-5 - 2*cost + 2*sqr(cost) + trip(cost)))/sqr(MZs) + (2*(MWs - MZs)*I3f[index(ot)]*Qf[index(ot)]*(-9 - 3*cost + 3*sqr(cost) + trip(cost)))/MZs + sqr(I3f[index(ot)])*(-9 - 3*cost + 3*sqr(cost) + trip(cost)))))/(4.*sqr(1 + cost)*sqr(MWs)*sqr(MWs - MZs));
      break;
