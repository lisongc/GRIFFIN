s) - cost*sqr(MZs) + sqr(cost)*sqr(MZs) - sqr(MZs)*trip(cost)))/(32.*sqr(1 + cost)*sqr(MWs - MZs)) - (2*C0(0,MZs,0,0,MZs,MZs)*powint(MZs,4)*(4*powint(MZs,-4)*sqr(MWs - MZs)*sqr(Qf[index(it)])*(2*(MWs - MZs)*MZs*I3f[index(ot)]*Qf[index(ot)] + sqr(MZs)*sqr(I3f[index(ot)]) + 2*sqr(MWs - MZs)*sqr(Qf[index(ot)])) + sqr(I3f[index(it)])*((4*sqr(MWs - MZs)*sqr(Qf[index(ot)]))/sqr(MZs) + (2*(MWs - MZs)*I3f[index(ot)]*Qf[index(ot)]*(2 - 3*cost + trip(cost)))/MZs + sqr(I3f[index(ot)])*(2 - 3*cost + trip(cost))) + 2*(MWs - MZs)*I3f[index(it)]*Qf[index(it)]*powint(MZs,-3)*(2*(2 + cost)*(MWs - MZs)*MZs*I3f[index(ot)]*Qf[index(ot)]*sqr(-1 + cost) + 4*sqr(MWs - MZs)*sqr(Qf[index(ot)]) + sqr(MZs)*sqr(I3f[index(ot)])*(2 - 3*cost + trip(cost)))))/(sqr(-1 + cost)*sqr(1 + cost)*sqr(MWs)*sqr(MWs - MZs)) - (D0(((-1 + cost)*MZs)/2.,0,MZs,0,0,0,0,0,MZs,MZs)*powint(MZs,5)*(2*powint(MZs,-4)*(-4 - cost + sqr(cost))*sqr(MWs - MZs)*sqr(Qf[index(it)])*(2*(MWs - MZs)*MZs*I3f[index(ot)]*Qf[index(ot)] + sqr(MZs)*sqr(I3f[index(ot)]) + 2*sqr(MWs - MZs)*sqr(Qf[index(ot)])) - (2*(-MWs + MZs)*I3f[index(it)]*Qf[index(it)]*((2*(-4 - cost + sqr(cost))*sqr(MWs - MZs)*sqr(Qf[index(ot)]))/sqr(MZs) + (2*(MWs - MZs)*I3f[index(ot)]*Qf[index(ot)]*(-9 - 3*cost + 3*sqr(cost) + trip(cost)))/MZs + sqr(I3f[index(ot)])*(-9 - 3*cost + 3*sqr(cost) + trip(cost))))/MZs + sqr(I3f[index(it)])*((2*(-4 - cost + sqr(cost))*sqr(MWs - MZs)*sqr(Qf[index(ot)]))/sqr(MZs) + (2*(MWs - MZs)*I3f[index(ot)]*Qf[index(ot)]*(-9 - 3*cost + 3*sqr(cost) + trip(cost)))/MZs + sqr(I3f[index(ot)])*(-9 - 3*cost + 3*sqr(cost) + trip(cost)))))/(4.*sqr(1 + cost)*sqr(MWs)*sqr(MWs - MZs));
    }
    break;
  }
  return(res*sqr(AL));
}

// contribution from gamma-Z box contributing to R
double bRaz1(Fermion it, Fermion ot, double cost, const inval& input)
{
  double AL = input.get(InputPar::alpha);
  Cplx res = -li2((-1 + cost)/(1 + cost)) + li2((1 + cost)/(-1 + cost)) + log((1 - cost)/(1 + cost))*(-0.5 - log(-4/(-1 + sqr(cost)))/2.);
  return(real(res)*(AL*Qf[index(it)]*Qf[index(ot)])/Pi);
}

