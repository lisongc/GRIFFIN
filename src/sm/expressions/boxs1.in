// one-loop box diagrams for arbitrary s
Cplx B1s(Fermion it, Fermion ot, Current if1, Current of1, double s, double t, const inval& input, int AA, int AZ, int LS, int ZZ, int WW)
{
  double MZs = sqr(input.get(InputPar::ZMassComplex)),
         MWs = sqr(input.get(InputPar::WMassComplex)),
         MTs = sqr(input.get(InputPar::topMass)),
         AL = input.get(InputPar::alpha),
         MIs, MFs;
  Cplx res = 0;
  if(it==Fermion::b)
    MIs = MTs;
  else
    MIs = 0;
  if(ot==Fermion::b)
    MFs = MTs;
  else
    MFs = 0;
  switch(if1) {
   case Current::scalar:
   case Current::pseudoscalar:
    break;
   case Current::vector:
    switch(of1) {
     case Current::scalar:
     case Current::pseudoscalar:
      break;
     case Current::vector:
      res = -((AZ*B0fin(s,MZs,0)*Qf[index(it)]*Qf[index(ot)]*((MWs - MZs)*(s + 2*t)*Qf[index(it)]*(MZs*I3f[index(ot)] + 2*(MWs - MZs)*Qf[index(ot)]) + MZs*I3f[index(it)]*(MZs*t*I3f[index(ot)] + (MWs - MZs)*(s + 2*t)*Qf[index(ot)])))/(MWs*(MWs - MZs)*t*(s + t))) + ((MFs + MIs + s + t)*WW*D0(-s - t,0,s,0,0,0,MFs,MIs,MWs,MWs)*(-1 + 4*I3f[index(it)]*I3f[index(ot)])*sqr(MZs))/(16.*sqr(MWs - MZs)) + (WW*B0fin(s,MWs,MWs)*(1 + 4*I3f[index(it)]*I3f[index(ot)])*sqr(MZs))/(16.*(s + t)*sqr(MWs - MZs)) - (WW*B0fin(t,MFs,MIs)*(1 + 4*I3f[index(it)]*I3f[index(ot)])*sqr(MZs))/(16.*(s + t)*sqr(MWs - MZs)) - (AZ*li2((-MZs + s + t)/(s + t))*Qf[index(it)]*Qf[index(ot)]*((MWs - MZs)*Qf[index(it)]*(MZs*I3f[index(ot)] + 2*(MWs - MZs)*Qf[index(ot)])*(2*s*t - 2*MZs*(s + t) + sqr(MZs) + sqr(s) + 4*sqr(t)) + MZs*I3f[index(it)]*(2*MZs*I3f[index(ot)]*sqr(t) + (MWs - MZs)*Qf[index(ot)]*(2*s*t - 2*MZs*(s + t) + sqr(MZs) + sqr(s) + 4*sqr(t)))))/(2.*MWs*(MWs - MZs)*(MZs - s)*sqr(t)) - (t*(-MFs - MIs + 2*MWs + s + 2*t)*WW*C0(t,0,0,MFs,MIs,MWs)*(1 + 4*I3f[index(it)]*I3f[index(ot)])*sqr(MZs))/(16.*sqr(MWs - MZs)*sqr(s + t)) + (WW*C0(0,s,0,MFs,MWs,MWs)*sqr(MZs)*(s*(MFs + MIs - 2*MWs - s - 2*t) + 4*I3f[index(it)]*I3f[index(ot)]*(MFs*s + MIs*s - 2*MWs*s + 6*s*t + 3*sqr(s) + 4*sqr(t))))/(32.*sqr(MWs - MZs)*sqr(s + t)) + (WW*C0(0,s,0,MIs,MWs,MWs)*sqr(MZs)*(s*(MFs + MIs - 2*MWs - s - 2*t) + 4*I3f[index(it)]*I3f[index(ot)]*(MFs*s + MIs*s - 2*MWs*s + 6*s*t + 3*sqr(s) + 4*sqr(t))))/(32.*sqr(MWs - MZs)*sqr(s + t)) - (2*AZ*li2(-(s/(MZs - s)))*Qf[index(it)]*Qf[index(ot)]*sqr(MZs)*(((-MWs + MZs)*(s + 2*t)*Qf[index(it)]*(MZs*I3f[index(ot)] + 2*(MWs - MZs)*Qf[index(ot)])*(MZs*s - 2*s*t - sqr(s) - 2*sqr(t)))/sqr(MZs) + I3f[index(it)]*(((-MWs + MZs)*(s + 2*t)*Qf[index(ot)]*(MZs*s - 2*s*t - sqr(s) - 2*sqr(t)))/MZs + (MZs + s + 2*t)*I3f[index(ot)]*sqr(t))))/(MWs*(-MWs + MZs)*sqr(t)*sqr(s + t)) - (AZ*li2c(s/MZs)*Qf[index(it)]*Qf[index(ot)]*sqr(MZs)*(((-MWs + MZs)*(s + 2*t)*Qf[index(it)]*(MZs*I3f[index(ot)] + 2*(MWs - MZs)*Qf[index(ot)])*(MZs*s - 2*s*t - sqr(s) - 2*sqr(t)))/sqr(MZs) + I3f[index(it)]*(((-MWs + MZs)*(s + 2*t)*Qf[index(ot)]*(MZs*s - 2*s*t - sqr(s) - 2*sqr(t)))/MZs + (MZs + s + 2*t)*I3f[index(ot)]*sqr(t))))/(MWs*(-MWs + MZs)*sqr(t)*sqr(s + t)) + (AZ*li2((MZs + t)/t)*Qf[index(it)]*Qf[index(ot)]*((MWs - MZs)*t*Qf[index(it)]*(MZs*I3f[index(ot)] + 2*(MWs - MZs)*Qf[index(ot)])*(2*MZs*t + 6*s*t + sqr(MZs) + 3*sqr(s) + 4*sqr(t)) + MZs*I3f[index(it)]*(MZs*t*I3f[index(ot)]*(2*MZs*t + 2*s*t + sqr(MZs) + sqr(s) + 2*sqr(t)) + (MWs - MZs)*t*Qf[index(ot)]*(2*MZs*t + 6*s*t + sqr(MZs) + 3*sqr(s) + 4*sqr(t)))))/(2.*MWs*(MWs - MZs)*(MZs - s)*t*sqr(s + t)) + (Qf[index(it)]*Qf[index(ot)]*(12*AA*MWs*(MWs - MZs)*(MZs - s)*clog1(-(MZs/s))*clog2(-(t/(s + t)))*Qf[index(it)]*Qf[index(ot)]*sqr(t)*(6*s*t + 3*sqr(s) + 4*sqr(t)) + (MZs - s)*s*sqr(Pi)*(AZ*MZs*I3f[index(it)]*(-((MWs - MZs)*(s + 2*t)*Qf[index(ot)]*(MZs*s - 2*s*t - sqr(s) - 2*sqr(t))) + MZs*(MZs + s + 2*t)*I3f[index(ot)]*sqr(t)) - (MWs - MZs)*(s + 2*t)*Qf[index(it)]*(AZ*MZs*I3f[index(ot)]*(MZs*s - 2*s*t - sqr(s) - 2*sqr(t)) + 2*Qf[index(ot)]*(AZ*(MWs - MZs)*(MZs*s - 2*s*t - sqr(s) - 2*sqr(t)) + 3*AA*MWs*(2*s*t + sqr(s) + 2*sqr(t))))) - 6*t*clog2(-(t/(s + t)))*(t*(AZ*MZs*s*I3f[index(it)]*(MZs*I3f[index(ot)] + 2*(MWs - MZs)*Qf[index(ot)]) + 2*(MWs - MZs)*Qf[index(it)]*(AZ*MZs*s*I3f[index(ot)] + 2*(AA*MWs*(MZs - s) + AZ*(MWs - MZs)*s)*Qf[index(ot)]))*sqr(s + t) + t*clog1(-(sqr(MZs)/(t*(s + t))))*(AZ*MZs*s*I3f[index(it)]*(MZs*I3f[index(ot)] + 2*(MWs - MZs)*Qf[index(ot)]) + 2*(MWs - MZs)*Qf[index(it)]*(AZ*MZs*s*I3f[index(ot)] + 2*(AA*MWs*(MZs - s) + AZ*(MWs - MZs)*s)*Qf[index(ot)]))*sqr(s + t) + 2*AZ*s*clog2(1 - s/MZs)*((MWs - MZs)*t*Qf[index(it)]*(MZs*I3f[index(ot)] + 2*(MWs - MZs)*Qf[index(ot)])*(2*MZs*t + 6*s*t + sqr(MZs) + 3*sqr(s) + 4*sqr(t)) + MZs*I3f[index(it)]*(MZs*t*I3f[index(ot)]*(2*MZs*t + 2*s*t + sqr(MZs) + sqr(s) + 2*sqr(t)) + (MWs - MZs)*t*Qf[index(ot)]*(2*MZs*t + 6*s*t + sqr(MZs) + 3*sqr(s) + 4*sqr(t))) - 2*LS*t*(MZs*I3f[index(it)] + 2*(MWs - MZs)*Qf[index(it)])*(MZs*I3f[index(ot)] + 2*(MWs - MZs)*Qf[index(ot)])*sqr(s + t))) - 6*AA*MWs*(MWs - MZs)*(MZs - s)*s*(s + 2*t)*Qf[index(it)]*Qf[index(ot)]*(2*s*t + sqr(s) + 2*sqr(t))*sqr(clog1(-(MZs/s))) - 12*AZ*(MZs - s)*s*((MWs - MZs)*(s + 2*t)*Qf[index(it)]*(MZs*I3f[index(ot)] + 2*(MWs - MZs)*Qf[index(ot)])*(MZs*s - 2*s*t - sqr(s) - 2*sqr(t)) - MZs*I3f[index(it)]*(-((MWs - MZs)*(s + 2*t)*Qf[index(ot)]*(MZs*s - 2*s*t - sqr(s) - 2*sqr(t))) + MZs*(MZs + s + 2*t)*I3f[index(ot)]*sqr(t)))*sqr(clog2(1 - s/MZs)) + 3*(MZs - s)*s*(AZ*MZs*(MZs + s + 2*t)*I3f[index(it)]*(MZs*I3f[index(ot)] + (MWs - MZs)*Qf[index(ot)]) + (MWs - MZs)*Qf[index(it)]*(AZ*MZs*(MZs + s + 2*t)*I3f[index(ot)] - 2*(AA*MWs*(s + 2*t) - AZ*(MWs - MZs)*(MZs + s + 2*t))*Qf[index(ot)]))*sqr(t)*sqr(clog2(-(t/(s + t))))))/(12.*MWs*(MWs - MZs)*(MZs - s)*s*sqr(t)*sqr(s + t)) - (Qf[index(it)]*Qf[index(ot)]*((AZ*MZs*(MZs - s - 2*t)*I3f[index(ot)]*Qf[index(it)] + (AZ*MZs*(MZs - s - 2*t)*I3f[index(it)] + 2*(AZ*(MWs - MZs)*(MZs - s - 2*t) + AA*MWs*(s + 2*t))*Qf[index(it)])*Qf[index(ot)])/sqr(t) + (AZ*MZs*(MZs + s + 2*t)*I3f[index(it)]*(MZs*I3f[index(ot)] + (MWs - MZs)*Qf[index(ot)]) + (MWs - MZs)*Qf[index(it)]*(AZ*MZs*(MZs + s + 2*t)*I3f[index(ot)] - 2*(AA*MWs*(s + 2*t) - AZ*(MWs - MZs)*(MZs + s + 2*t))*Qf[index(ot)]))/((-MWs + MZs)*sqr(s + t)))*sqr(log(MZs/(s + t))))/(4.*MWs) + (AA*(s + 2*t)*B0fin(s,0,0)*sqr(Qf[index(it)])*sqr(Qf[index(ot)]))/(t*(s + t)) + ((s + t)*C0(-s - t,0,0,0,0,MZs)*sqr(MZs)*(((AZ*MWs*(MZs - s - 2*t) + 2*(-MWs + MZs)*(2*MZs - s - 2*t)*ZZ)*I3f[index(ot)]*Qf[index(ot)]*sqr(Qf[index(it)]))/MZs + (-2*MZs + s + 2*t)*ZZ*sqr(I3f[index(ot)])*sqr(Qf[index(it)]) + (((AZ*MWs*(MZs - s - 2*t) - 2*(MWs - MZs)*(2*MZs - s - 2*t)*ZZ)*I3f[index(it)]*Qf[index(it)])/MZs - (2*MZs - s - 2*t)*ZZ*sqr(I3f[index(it)]) + (2*(MWs - MZs)*(AZ*MWs*(MZs - s - 2*t) - (MWs - MZs)*(2*MZs - s - 2*t)*ZZ)*sqr(Qf[index(it)]))/sqr(MZs))*sqr(Qf[index(ot)])))/(2.*sqr(MWs)*sqr(t)) - (B0fin(-s - t,0,0)*(-2*MZs*(AZ*MWs + (-MWs + MZs)*ZZ)*I3f[index(ot)]*Qf[index(ot)]*sqr(Qf[index(it)]) + ZZ*sqr(MZs)*sqr(I3f[index(ot)])*sqr(Qf[index(it)]) + (-2*MZs*(AZ*MWs + (-MWs + MZs)*ZZ)*I3f[index(it)]*Qf[index(it)] + ZZ*sqr(MZs)*sqr(I3f[index(it)]) + 2*(2*MWs*MZs*(AZ - ZZ) + (AA - 2*AZ + ZZ)*sqr(MWs) + ZZ*sqr(MZs))*sqr(Qf[index(it)]))*sqr(Qf[index(ot)])))/(2.*t*sqr(MWs)) + (ZZ*B0fin(s,MZs,MZs)*((s + 2*t)*sqr(MWs - MZs)*sqr(Qf[index(it)])*(2*(MWs - MZs)*MZs*I3f[index(ot)]*Qf[index(ot)] + sqr(MZs)*sqr(I3f[index(ot)]) + 2*sqr(MWs - MZs)*sqr(Qf[index(ot)])) + 2*(MWs - MZs)*MZs*I3f[index(it)]*Qf[index(it)]*(2*(MWs - MZs)*MZs*t*I3f[index(ot)]*Qf[index(ot)] + t*sqr(MZs)*sqr(I3f[index(ot)]) + (s + 2*t)*sqr(MWs - MZs)*sqr(Qf[index(ot)])) + sqr(MZs)*sqr(I3f[index(it)])*(2*(MWs - MZs)*MZs*t*I3f[index(ot)]*Qf[index(ot)] + t*sqr(MZs)*sqr(I3f[index(ot)]) + (s + 2*t)*sqr(MWs - MZs)*sqr(Qf[index(ot)]))))/(2.*t*(s + t)*sqr(MWs)*sqr(MWs - MZs)) - (s*ZZ*C0(0,s,0,0,MZs,MZs)*powint(MZs,4)*(((s + 2*t)*sqr(MWs - MZs)*(-2*MZs*s + 2*s*t + sqr(s) + 2*sqr(t))*sqr(Qf[index(it)])*((2*(MWs - MZs)*I3f[index(ot)]*Qf[index(ot)])/MZs + sqr(I3f[index(ot)]) + (2*sqr(MWs - MZs)*sqr(Qf[index(ot)]))/sqr(MZs)))/sqr(MZs) + (2*(-MWs + MZs)*I3f[index(it)]*Qf[index(it)]*((2*(-MWs + MZs)*(2*MZs + s + 2*t)*I3f[index(ot)]*Qf[index(ot)]*sqr(t))/MZs - (2*MZs + s + 2*t)*sqr(t)*sqr(I3f[index(ot)]) - ((s + 2*t)*sqr(MWs - MZs)*(-2*MZs*s + 2*s*t + sqr(s) + 2*sqr(t))*sqr(Qf[index(ot)]))/sqr(MZs)))/MZs + sqr(I3f[index(it)])*((2*(MWs - MZs)*(2*MZs + s + 2*t)*I3f[index(ot)]*Qf[index(ot)]*sqr(t))/MZs + (2*MZs + s + 2*t)*sqr(t)*sqr(I3f[index(ot)]) + ((s + 2*t)*sqr(MWs - MZs)*(-2*MZs*s + 2*s*t + sqr(s) + 2*sqr(t))*sqr(Qf[index(ot)]))/sqr(MZs))))/(2.*sqr(MWs)*sqr(MWs - MZs)*sqr(t)*sqr(s + t)) - (B0fin(t,0,0)*(2*(MWs - MZs)*MZs*I3f[index(it)]*Qf[index(it)]*(MZs*I3f[index(ot)] + (MWs - MZs)*Qf[index(ot)])*(MZs*ZZ*I3f[index(ot)] - (AZ*MWs + (-MWs + MZs)*ZZ)*Qf[index(ot)]) + sqr(MWs - MZs)*sqr(Qf[index(it)])*(-2*MZs*(AZ*MWs + (-MWs + MZs)*ZZ)*I3f[index(ot)]*Qf[index(ot)] + ZZ*sqr(MZs)*sqr(I3f[index(ot)]) + 2*(2*MWs*MZs*(AZ - ZZ) + (AA - 2*AZ + ZZ)*sqr(MWs) + ZZ*sqr(MZs))*sqr(Qf[index(ot)])) + ZZ*sqr(MZs)*sqr(I3f[index(it)])*sqr(MZs*I3f[index(ot)] + (MWs - MZs)*Qf[index(ot)])))/(2.*(s + t)*sqr(MWs)*sqr(MWs - MZs)) - (t*C0(t,0,0,0,0,MZs)*((MWs - MZs)*MZs*I3f[index(it)]*Qf[index(it)]*(MZs*I3f[index(ot)] + (MWs - MZs)*Qf[index(ot)])*(2*MZs*(2*MZs + s + 2*t)*ZZ*I3f[index(ot)] - (AZ*MWs*(MZs + s + 2*t) - 2*(MWs - MZs)*(2*MZs + s + 2*t)*ZZ)*Qf[index(ot)]) + sqr(MWs - MZs)*sqr(Qf[index(it)])*(-(MZs*(AZ*MWs*(MZs + s + 2*t) - 2*(MWs - MZs)*(2*MZs + s + 2*t)*ZZ)*I3f[index(ot)]*Qf[index(ot)]) + (2*MZs + s + 2*t)*ZZ*sqr(MZs)*sqr(I3f[index(ot)]) - 2*(MWs - MZs)*(AZ*MWs*(MZs + s + 2*t) - (MWs - MZs)*(2*MZs + s + 2*t)*ZZ)*sqr(Qf[index(ot)])) + (2*MZs + s + 2*t)*ZZ*sqr(MZs)*sqr(I3f[index(it)])*sqr(MZs*I3f[index(ot)] + (MWs - MZs)*Qf[index(ot)])))/(2.*sqr(MWs)*sqr(MWs - MZs)*sqr(s + t)) + (ZZ*D0(t,0,s,0,0,0,0,0,MZs,MZs)*(powint(MWs - MZs,4)*(2*(s - t)*sqr(MZs) - 4*MZs*sqr(t) - t*(2*s*t + sqr(s) + 2*sqr(t)))*sqr(Qf[index(it)])*sqr(Qf[index(ot)]) - 2*t*sqr(MWs - MZs)*sqr(s + t)*sqr(MZs*I3f[index(it)] + (MWs - MZs)*Qf[index(it)])*sqr(Qf[index(ot)]) - 2*t*sqr(MWs - MZs)*sqr(s + t)*sqr(Qf[index(it)])*sqr(MZs*I3f[index(ot)] + (MWs - MZs)*Qf[index(ot)]) + (2*(s - t)*sqr(MZs) - 4*MZs*sqr(t) - t*(2*s*t + sqr(s) + 2*sqr(t)))*sqr(MZs*I3f[index(it)] + (MWs - MZs)*Qf[index(it)])*sqr(MZs*I3f[index(ot)] + (MWs - MZs)*Qf[index(ot)])))/(4.*sqr(MWs)*sqr(MWs - MZs)*sqr(s + t)) + (WW*D0(t,0,s,0,0,0,MFs,MIs,MWs,MWs)*(1 + 4*I3f[index(it)]*I3f[index(ot)])*sqr(MZs)*(s*sqr(MFs) + s*sqr(MIs) + 2*s*sqr(MWs) - 2*t*sqr(MWs) - t*sqr(s) - 4*MWs*sqr(t) - 2*s*sqr(t) + MIs*(-2*MWs*s + 2*MWs*t + s*t + sqr(s) + 2*sqr(t)) + MFs*(-2*MWs*s - 2*MIs*t + 2*MWs*t + s*t + sqr(s) + 2*sqr(t)) - 2*trip(t)))/(32.*sqr(MWs - MZs)*sqr(s + t)) - (ZZ*D0(-s - t,0,s,0,0,0,0,0,MZs,MZs)*(2*(s + t)*powint(MWs - MZs,4)*sqr(t)*sqr(Qf[index(it)])*sqr(Qf[index(ot)]) + 2*(s + t)*sqr(t)*sqr(MZs*I3f[index(it)] + (MWs - MZs)*Qf[index(it)])*sqr(MZs*I3f[index(ot)] + (MWs - MZs)*Qf[index(ot)]) + sqr(MWs - MZs)*sqr(MZs*I3f[index(it)] + (MWs - MZs)*Qf[index(it)])*sqr(Qf[index(ot)])*(2*(2*s + t)*sqr(MZs) + 3*t*sqr(s) + 4*s*sqr(t) - 4*MZs*sqr(s + t) + trip(s) + 2*trip(t)) + sqr(MWs - MZs)*sqr(Qf[index(it)])*sqr(MZs*I3f[index(ot)] + (MWs - MZs)*Qf[index(ot)])*(2*(2*s + t)*sqr(MZs) + 3*t*sqr(s) + 4*s*sqr(t) - 4*MZs*sqr(s + t) + trip(s) + 2*trip(t))))/(4.*sqr(MWs)*sqr(MWs - MZs)*sqr(t)) + (log(MZs/(s + t))*Qf[index(it)]*Qf[index(ot)]*((-2*AZ*clog2(1 - s/MZs)*((MWs - MZs)*Qf[index(it)]*(MZs*I3f[index(ot)] + 2*(MWs - MZs)*Qf[index(ot)])*(2*s*t - 2*MZs*(s + t) + sqr(MZs) + sqr(s) + 4*sqr(t)) + MZs*I3f[index(it)]*(2*MZs*I3f[index(ot)]*sqr(t) + (MWs - MZs)*Qf[index(ot)]*(2*s*t - 2*MZs*(s + t) + sqr(MZs) + sqr(s) + 4*sqr(t))) - (t*((MWs - MZs)*t*Qf[index(it)]*(MZs*I3f[index(ot)] + 2*(MWs - MZs)*Qf[index(ot)])*(2*MZs*t + 6*s*t + sqr(MZs) + 3*sqr(s) + 4*sqr(t)) + MZs*I3f[index(it)]*(MZs*t*I3f[index(ot)]*(2*MZs*t + 2*s*t + sqr(MZs) + sqr(s) + 2*sqr(t)) + (MWs - MZs)*t*Qf[index(ot)]*(2*MZs*t + 6*s*t + sqr(MZs) + 3*sqr(s) + 4*sqr(t)))))/sqr(s + t)))/(MWs*(MWs - MZs)*(MZs - s)*sqr(t)) + (clog2(-(t/(s + t)))*(AZ*MZs*(MZs + s + 2*t)*I3f[index(it)]*(MZs*I3f[index(ot)] + (MWs - MZs)*Qf[index(ot)]) + (MWs - MZs)*Qf[index(it)]*(AZ*MZs*(MZs + s + 2*t)*I3f[index(ot)] - 2*(AA*MWs*(s + 2*t) - AZ*(MWs - MZs)*(MZs + s + 2*t))*Qf[index(ot)])))/(MWs*(-MWs + MZs)*sqr(s + t)) + (2*AA*clog1(-(MZs/s))*Qf[index(it)]*Qf[index(ot)]*(4*t*sqr(s) + 6*s*sqr(t) + trip(s) + 4*trip(t)))/(sqr(t)*sqr(s + t))))/2.;
