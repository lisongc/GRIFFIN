Cplx g2f(int type, int form, double s, const inval& input)
{
  double MZs = sqr(input.get(MZ)),
         MWs = sqr(input.get(MW)),
         MHs = sqr(input.get(MH)),
         MTs = sqr(input.get(MT)),
         AL = input.get(al),
         deltaAlpha = input.get(Delal);
  Cplx res = 0;
  switch(form) {
   case VEC:
    switch(type) {
     case ELE:
     case MUO:
     case TAU:
      res = 0;
      break;
     case NUE:
     case NUM:
     case NUT:
      res = 0;
      break;
     case UQU:
     case CQU:
      res = 0;
      break;
     case DQU:
     case SQU:
     case BQU:
      res = 0;
      break;
    }
    break;
   case AXV:
    switch(type) {
     case ELE:
     case MUO:
     case TAU:
      res = 0;
      break;
     case NUE:
     case NUM:
     case NUT:
      res = 0;
      break;
     case UQU:
     case CQU:
      res = 0;
      break;
     case DQU:
     case SQU:
     case BQU:
      res = 0;
      break;
    }
    break;
  }
  return(res*1);
}

