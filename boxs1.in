])/MZs)*sqr(Qf[ot]) - ((2*(s - t)*sqr(MZs) - 4*MZs*sqr(t) - t*(2*s*t + sqr(s) + 2*sqr(t)))*sqr(MZs*I3f[it] + (MWs - MZs)*Qf[it])*sqr(MZs*I3f[ot] + (MWs - MZs)*Qf[ot]))/(sqr(MWs - MZs)*sqr(MZs)*sqr(s + t)) + 2*t*sqr(Qf[it])*sqr(I3f[ot] + ((MWs - MZs)*Qf[ot])/MZs)))/(4.*sqr(MWs)) + (D0(t,0,s,0,0,0,MFs,MIs,MWs,MWs)*(1 + 4*I3f[it]*I3f[ot])*sqr(MZs)*(s*sqr(MFs) + s*sqr(MIs) + 2*s*sqr(MWs) - 2*t*sqr(MWs) - t*sqr(s) - 4*MWs*sqr(t) - 2*s*sqr(t) + MIs*(-2*MWs*s + 2*MWs*t + s*t + sqr(s) + 2*sqr(t)) + MFs*(-2*MWs*s - 2*MIs*t + 2*MWs*t + s*t + sqr(s) + 2*sqr(t)) - 2*trip(t)))/(32.*sqr(MWs - MZs)*sqr(s + t)) - (D0(-s - t,0,s,0,0,0,0,0,MZs,MZs)*sqr(MZs)*((2*(s + t)*sqr(MWs - MZs)*sqr(Qf[it])*sqr(Qf[ot]))/sqr(MZs) + (2*(s + t)*sqr(MZs*I3f[it] + (MWs - MZs)*Qf[it])*sqr(MZs*I3f[ot] + (MWs - MZs)*Qf[ot]))/(sqr(MWs - MZs)*sqr(MZs)) + (sqr(I3f[it] + ((MWs - MZs)*Qf[it])/MZs)*sqr(Qf[ot])*(2*(2*s + t)*sqr(MZs) + 3*t*sqr(s) + 4*s*sqr(t) - 4*MZs*sqr(s + t) + trip(s) + 2*trip(t)))/sqr(t) + (sqr(Qf[it])*sqr(I3f[ot] + ((MWs - MZs)*Qf[ot])/MZs)*(2*(2*s + t)*sqr(MZs) + 3*t*sqr(s) + 4*s*sqr(t) - 4*MZs*sqr(s + t) + trip(s) + 2*trip(t)))/sqr(t)))/(4.*sqr(MWs)) + (log(MZs/(s + t))*Qf[it]*Qf[ot]*((-2*AZ*clog2(1 - s/MZs)*sqr(MZs)*((((MWs - MZs)*Qf[it]*(MZs*I3f[ot] + 2*(MWs - MZs)*Qf[ot])*(2*s*t - 2*MZs*(s + t) + sqr(MZs) + sqr(s) + 4*sqr(t)))/sqr(MZs) - I3f[it]*(-2*I3f[ot]*sqr(t) + ((-MWs + MZs)*Qf[ot]*(2*s*t - 2*MZs*(s + t) + sqr(MZs) + sqr(s) + 4*sqr(t)))/MZs))/(MWs - MZs) + (t*(((MWs - MZs)*t*Qf[it]*(MZs*I3f[ot] + 2*(MWs - MZs)*Qf[ot])*(2*MZs*t + 6*s*t + sqr(MZs) + 3*sqr(s) + 4*sqr(t)))/sqr(MZs) + I3f[it]*(t*I3f[ot]*(2*MZs*t + 2*s*t + sqr(MZs) + sqr(s) + 2*sqr(t)) + ((MWs - MZs)*t*Qf[ot]*(2*MZs*t + 6*s*t + sqr(MZs) + 3*sqr(s) + 4*sqr(t)))/MZs)))/((-MWs + MZs)*sqr(s + t))))/(MWs*(MZs - s)*sqr(t)) + (clog2(-(t/(s + t)))*(AZ*(MZs + s + 2*t)*I3f[it]*(I3f[ot] + ((MWs - MZs)*Qf[ot])/MZs) + ((MWs - MZs)*Qf[it]*(AZ*MZs*(MZs + s + 2*t)*I3f[ot] - 2*(AA*MWs*(s + 2*t) - AZ*(MWs - MZs)*(MZs + s + 2*t))*Qf[ot])