// one-loop box diagrams for arbitrary s
Cplx B1s(int it, int ot, int if1, int of1, double s, double t, const inval& input, int AA, int AZ, int LS)
{
  double MZs = sqr(input.get(MZ)),
         MWs = sqr(input.get(MW)),
         MTs = sqr(input.get(MT)),
