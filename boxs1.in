// one-loop box diagrams for arbitrary s
Cplx B1s(int it, int ot, int if1, int of1, double s, double t, const inval& input, int AA, int AZ, int LS, int ZZ, int WW)
{
  double MZs = sqr(input.get(MZ)),
         MWs = sqr(input.get(MW)),
         MTs = sqr(input.get(MT)),
         AL = input.get(al),
         MIs, MFs;
  Cplx res = 0;
  if(it==BQU)
    MIs = MTs;
  else
    MIs = 0;
  if(ot==BQU)
    MFs = MTs;
  else
    MFs = 0;
  switch(if1) {
   case VEC:
    switch(of1) {
     case VEC:
      res = -((AZ*B0fin(s,MZs,0)*Qf[it]*Qf[ot]*((MWs - MZs)*(s + 2*t)*Qf[it]*(MZs*I3f[ot] + 2*(MWs - MZs)*Qf[ot]) + MZs*I3f[it]*(MZs*t*I3f[ot] + (MWs - MZs)*(s + 2*t)*Qf[ot])))/(MWs*(MWs - MZs)*t*(s + t))) + ((MFs + MIs + s + t)*WW*D0(-s - t,0,s,0,0,0,MFs,MIs,MWs,MWs)*(-1 + 4*I3f[it]*I3f[ot])*sqr(MZs))/(16.*sqr(MWs - MZs)) + (WW*B0fin(s,MWs,MWs)*(1 + 4*I3f[it]*I3f[ot])*sqr(MZs))/(16.*(s + t)*sqr(MWs - MZs)) - (WW*B0fin(t,MFs,MIs)*(1 + 4*I3f[it]*I3f[ot])*sqr(MZs))/(16.*(s + t)*sqr(MWs - MZs)) - (AZ*li2((-MZs + s + t)/(s + t))*Qf[it]*Qf[ot]*((MWs - MZs)*Qf[it]*(MZs*I3f[ot] + 2*(MWs - MZs)*Qf[ot])*(2*s*t - 2*MZs*(s + t) + sqr(MZs) + sqr(s) + 4*sqr(t)) + MZs*I3f[it]*(2*MZs*I3f[ot]*sqr(t) + (MWs - MZs)*Qf[ot]*(2*s*t - 2*MZs*(s + t) + sqr(MZs) + sqr(s) + 4*sqr(t)))))/(2.*MWs*(MWs - MZs)*(MZs - s)*sqr(t)) - (t*(-MFs - MIs + 2*MWs + s + 2*t)*WW*C0(t,0,0,MFs,MIs,MWs)*(1 + 4*I3f[it]*I3f[ot])*sqr(MZs))/(16.*sqr(MWs - MZs)*sqr(s + t)) + (WW*C0(0,s,0,MFs,MWs,MWs)*sqr(MZs)*(s*(MFs + MIs - 2*MWs - s - 2*t) + 4*I3f[it]*I3f[ot]*(MFs*s + MIs*s - 2*MWs*s + 6*s*t + 3*sqr(s) + 4*sqr(t))))/(32.*sqr(MWs - MZs)*sqr(s + t)) + (WW*C0(0,s,0,MIs,MWs,MWs)*sqr(MZs)*(s*(MFs + MIs - 2*MWs - s - 2*t) + 4*I3f[it]*I3f[ot]*(MFs*s + MIs*s - 2*MWs*s + 6*s*t + 3*sqr(s) + 4*sqr(t))))/(32.*sqr(MWs - MZs)*sqr(s + t)) - (2*AZ*li2(-(s/(MZs - s)))*Qf[it]*Qf[ot]*sqr(MZs)*(((-MWs + MZs)*(s + 2*t)*Qf[it]*(MZs*I3f[ot] + 2*(MWs - MZs)*Qf[ot])*(MZs*s - 2*s*t - sqr(s) - 2*sqr(t)))/sqr(MZs) + I3f[it]*(((-MWs + MZs)*(s + 2*t)*Qf[ot]*(MZs*s - 2*s*t - sqr(s) - 2*sqr(t)))/MZs + (MZs + s + 2*t)*I3f[ot]*sqr(t))))/(MWs*(-MWs + MZs)*sqr(t)*sqr(s + t)) - (AZ*li2c(s/MZs)*Qf[it]*Qf[ot]*sqr(MZs)*(((-MWs + MZs)*(s + 2*t)*Qf[it]*(MZs*I3f[ot] + 2*(MWs - MZs)*Qf[ot])*(MZs*s - 2*s*t - sqr(s) - 2*sqr(t)))/sqr(MZs) + I3f[it]*(((-MWs + MZs)*(s + 2*t)*Qf[ot]*(MZs*s - 2*s*t - sqr(s) - 2*sqr(t)))/MZs + (MZs + s + 2*t)*I3f[ot]*sqr(t))))/(MWs*(-MWs + MZs)*sqr(t)*sqr(s + t)) + (AZ*li2((MZs + t)/t)*Qf[it]*Qf[ot]*((MWs - MZs)*t*Qf[it]*(MZs*I3f[o