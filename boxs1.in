MZs + s + 2*t)*I3f[ot] - 2*(AA*MWs*(s + 2*t) - AZ*(MWs - MZs)*(MZs + s + 2*t))*Qf[ot]))*sqr(t)*sqr(clog2(-(t/(s + t))))))/(12.*MWs*(MWs - MZs)*(MZs - s)*s*sqr(t)*sqr(s + t)) - (Qf[it]*Qf[ot]*((AZ*MZs*(MZs - s - 2*t)*I3f[ot]*Qf[it] + (AZ*MZs*(MZs - s - 2*t)*I3f[it] + 2*(AZ*(MWs - MZs)*(MZs - s - 2*t) + AA*MWs*(s + 2*t))*Qf[it])*Qf[ot])/sqr(t) + (AZ*MZs*(MZs + s + 2*t)*I3f[it]*(MZs*I3f[ot] + (MWs - MZs)*Qf[ot]) + (MWs - MZs)*Qf[it]*(AZ*MZs*(MZs + s + 2*t)*I3f[ot] - 2*(AA*MWs*(s + 2*t) - AZ*(MWs - MZs)*(MZs + s + 2*t))*Qf[ot]))/((-MWs + MZs)*sqr(s + t)))*sqr(log(MZs/(s + t))))/(4.*MWs) + (AA*(s + 2*t)*B0fin(s,0,0)*sqr(Qf[it])*sqr(Qf[ot]))/(t*(s + t)) + ((s + t)*C0(-s - t,0,0,0,0,MZs)*sqr(MZs)*(((AZ*MWs*(MZs - s - 2*t) + 2*(-MWs + MZs)*(2*MZs - s - 2*t)*ZZ)*I3f[ot]*Qf[ot]*sqr(Qf[it]))/MZs + (-2*MZs + s + 2*t)*ZZ*sqr(I3f[ot])*sqr(Qf[it]) + (((AZ*MWs*(MZs - s - 2*t) - 2*(MWs - MZs)*(2*MZs - s - 2*t)*ZZ)*I3f[it]*Qf[it])/MZs - (2*MZs - s - 2*t)*ZZ*sqr(I3f[it]) + (2*(MWs - MZs)*(AZ*MWs*(MZs - s - 2*t) - (MWs - MZs)*(2*MZs - s - 2*t)*ZZ)*sqr(Qf[it]))/sqr(MZs))*sqr(Qf[ot])))/(2.*sqr(MWs)*sqr(t)) - (B0fin(-s - t,0,0)*(-2*MZs*(AZ*MWs + (-MWs + MZs)*ZZ)*I3f[ot]*Qf[ot]*sqr(Qf[it]) + ZZ*sqr(MZs)*sqr(I3f[ot])*sqr(Qf[it]) + (-2*MZs*(AZ*MWs + (-MWs + MZs)*ZZ)*I3f[it]*Qf[it] + ZZ*sqr(MZs)*sqr(I3f[it]) + 2*(2*MWs*MZs*(AZ - ZZ) + (AA - 2*AZ + ZZ)*sqr(MWs) + ZZ*sqr(MZs))*sqr(Qf[it]))*sqr(Qf[ot])))/(2.*t*sqr(MWs)) + (ZZ*B0fin(s,MZs,MZs)*((s + 2*t)*sqr(MWs - MZs)*sqr(Qf[it])*(2*(MWs - MZs)*MZs*I3f[ot]*Qf[ot] + sqr(MZs)*sqr(I3f[ot]) + 2*sqr(MWs - MZs)*sqr(Qf[ot])) + 2*(MWs - MZs)*MZs*I3f[it]*Qf[it]*(2*(MWs - MZs)*MZs*t*I3f[ot]*Qf[ot] + t*sqr(MZs)*sqr(I3f[ot]) + (s + 2*t)*sqr(MWs - MZs)*sqr(Qf[ot])) + sqr(MZs)*sqr(I3f[it])*(2*(MWs - MZs)*MZs*t*I3f[ot]*Qf[ot] + t*sqr(MZs)*sqr(I3f[ot]) + (s + 2*t)*sqr(MWs - MZs)*sqr(Qf[ot]))))/(2.*t*(s + t)*sqr(MWs)*sqr(MWs - MZs)) - (s*ZZ*C0(0,s,0,0,MZs,MZs)*powint(MZs,4)*(((s + 2*t)*sqr(MWs - MZs)*(-2*MZs*s + 2*s*t + sqr(s) + 2*sqr(t))*sqr(Qf[it])*((2*(MWs - MZs)*I3f[ot]*Qf[ot])/MZs + sqr(I3f[ot]) + (2*sqr(MWs - MZs)*sqr(Qf[ot]))/sqr(MZs)))/sqr(MZs) + (2*(-MWs + MZs)*I3f[it]*Qf[it]*((2*(-MWs + MZs)*(2*MZs + s + 2*t)*I3f[ot]*Qf[ot]*sqr(t))/MZs - (2*MZs + s + 2*t)*sqr(t)*sqr(I3f[ot]) - ((s + 2*t)*sqr(MWs - MZs)*(-2*MZs*s + 2*s*t + sqr(s) + 2*sqr(t))*sqr(Qf[ot]))/sqr(MZs)))/MZs + sqr(I3f[it])*((2*(MWs - MZs)*(2*MZs + s + 2*t)*I3f[ot]*Qf[ot]*sqr(t))/MZs + (2*MZs + s + 2*t)*sqr(t)*sqr(I3f[ot]) + ((s + 2*t)*sqr(MWs - MZs)*(-2*MZs*s + 2*s*t + sqr(s) + 2*sqr(t))*sqr(Qf[ot]))/sqr(MZs))))/(2.*sqr(MWs)*sqr(MWs - MZs)*sqr(t)*sqr(s + t)) - (B0fin(t,0,0)*(2*(MWs - MZs)*MZs*I3f[it]*Qf[it]*(MZs*I3f[ot] + (MWs - MZs)*Qf[ot])*(MZs*ZZ*I3f[ot] - (AZ*MWs + (-MWs + MZs)*ZZ)*Qf[ot]) + sqr(MWs - MZs)*sqr(Qf[it])*(-2*MZs*(AZ*MWs + (-MWs + MZs)*ZZ)*I3f[ot]*Qf[ot] + ZZ*sqr(MZs)*sqr(I3f[ot]) + 2*(2*MWs*MZs*(AZ - ZZ) + (AA - 2*AZ + ZZ)*sqr(MWs) + ZZ*sqr(MZs))*sqr(Qf[ot])) + ZZ*sqr(MZs)*sqr(I3f[it])*sqr(MZs*I3f[ot] + (MWs - MZs)*Qf[ot])))/(2.*(s + t)*sqr(MWs)*sqr(MWs - MZs)) - (t*C0(t,0,0,0,0,MZs)*((MWs - MZs)*MZs*I3f[it]*Qf[it]*(MZs*I3f[ot] + (MWs - MZs)*Qf[ot])*(2*MZs*(2*MZs + s + 2*t)*ZZ*I3f[ot] - (AZ*MWs*(MZs + s + 2*t) - 2*(MWs - MZs)*(2*MZs + s + 2*t)*ZZ)*Qf[ot]) + sqr(MWs - MZs)*sqr(Qf[it])*(-(MZs*(AZ*MWs*(MZs + s + 2*t) - 2*(MWs - MZs)*(2*MZs + s + 2*t)*ZZ)*I3f[ot]*Qf[ot]) + (2*MZs + s + 2*t)*ZZ*sqr(MZs)*sqr(I3f[ot]) - 2*(MWs - MZs)*(AZ*MWs*(MZs + s + 2*t) - (MWs - MZs)*(2*MZs + s + 2*t)*ZZ)*sqr(Qf[ot])) + (2*MZs + s + 2*t)*ZZ*sqr(MZs)*sqr(I3f[it])*sqr(MZs*I3f[ot] + (MWs - MZs)*Qf[ot])))/(2.*sqr(MWs)*sqr(MWs - MZs)*sqr(s + t)) + (ZZ*D0(t,0,s,0,0,0,0,0,MZs,MZs)*(powint(MWs - MZs,4)*(2*(s - t)*sqr(MZs) - 4*MZs*sqr(t) - t*(2*s*t + sqr(s) + 2*sqr(t)))*sqr(Qf[it])*sqr(Qf[ot]) - 2*t*sqr(MWs - MZs)*sqr(s + t)*sqr(MZs*I3f[it] + (MWs - MZs)*Qf[it])*sqr(Qf[ot]) - 2*t*sqr(MWs - MZs)*sqr(s + t)*sqr(Qf[it])*sqr(MZs*I3f[ot] + (MWs - MZs)*Qf[ot]) + (2*(s - t)*sqr(MZs) - 4*MZs*sqr(t) - t*(2*s*t + sqr(s) + 2*sqr(t)))*sqr(MZs*I3f[it] + (MWs - MZs)*Qf[it])*sqr(MZs*I3f[ot] + (MWs - MZs)*Qf[ot])))/(4.*sqr(MWs)*sqr(MWs - MZs)*sqr(s + t)) + (WW*D0(t,0,s,0,0,0,MFs,MIs,MWs,MWs)*(1 + 4*I3f[it]*I3f[ot])*sqr(MZs)*(s*sqr(MFs) + s*sqr(MIs) + 2*s*sqr(MWs) - 2*t*sqr(MWs) - t*sqr(s) - 4*MWs*sqr(t) - 2*s*sqr(t) + MIs*(-2*MWs*s + 2*MWs*t + s*t + sqr(s) + 2*sqr(t)) + MFs*(-2*MWs*s - 2*MIs*t + 2*MWs*t + s*t + sqr(s) + 2*sqr(t)) - 2*trip(t)))/(32.*sqr(MWs - MZs)*sqr(s + t)) - (ZZ*D0(-s - t,0,s,0,0,0,0,0,MZs,MZs)*(2*(s + t)*powint(MWs - MZs,4)*sqr(t)*sqr(Qf[it])*sqr(Qf[ot]) + 2*(s + t)*sqr(t)*sqr(MZs*I3f[it] + (MWs - MZs)*Qf[it])*sqr(MZs*I3f[ot] + (MWs - MZs)*Qf[ot]) + sqr(MWs - MZs)*sqr(MZs*I3f[it] + (MWs - MZs)*Qf[it])*sqr(Qf[ot])*(2*(2*s + t)*sqr(MZs) + 3*t*sqr(s) + 4*s*sqr(t) - 4*MZs*sqr(s + t) + trip(s) + 2*trip(t)) + sqr(MWs - MZs)*sqr(Qf[it])*sqr(MZs*I3f[ot] + (MWs - MZs)*Qf[ot])*(2*(2*s + t)*sqr(MZs) + 3*t*sqr(s) + 4*s*sqr(t) - 4*MZs*sqr(s + t) + trip(s) + 2*trip(t))))/(4.*sqr(MWs)*sqr(MWs - MZs)*sqr(t)) + (log(MZs/(s + t))*Qf[it]*Qf[ot]*((-2*AZ*clog2(1 - s/MZs)*((MWs - MZs)*Qf[it]*(MZs*I3f[ot] + 2*(MWs - MZs)*Qf[ot])*(2*s*t - 2*MZs*(s + t) + sqr(MZs) + sqr(s) + 4*sqr(t)) + MZs*I3f[it]*(2*MZs*I3f[ot]*sqr(t) + (MWs - MZs)*Qf[ot]*(2*s*t - 2*MZs*(s + t) + sqr(MZs) + sqr(s) + 4*sqr(t))) - (t*((MWs - MZs)*t*Qf[it]*(MZs*I3f[ot] + 2*(MWs - MZs)*Qf[ot])*(2*MZs*t + 6*s*t + sqr(MZs) + 3*sqr(s) + 4*sqr(t)) + MZs*I3f[it]*(MZs*t*I3f[ot]*(2*MZs*t + 2*s*t + sqr(MZs) + sqr(s) + 2*sqr(t)) + (MWs - MZs)*t*Qf[ot]*(2*MZs*t + 6*s*t + sqr(MZs) + 3*sqr(s) + 4*sqr(t)))))/sqr(s + t)))/(MWs*(MWs - MZs)*(MZs - s)*sqr(t)) + (clog2(-(t/(s + t)))*(AZ*MZs*(MZs + s + 2*t)*I3f[it]*(MZs*I3f[ot] + (MWs - MZs)*Qf[ot]) + (MWs - MZs)*Qf[it]*(AZ*MZs*(MZs + s + 2*t)*I3f[ot] - 2*(AA*MWs*(s + 2*t) - AZ*(MWs - MZs)*(MZs + s + 2*t))*Qf[ot])))/(MWs*(-MWs + MZs)*sqr(s + t)) + (2*AA*clog1(-(MZs/s))*Qf[it]*Qf[ot]*(4*t*sqr(s) + 6*s*sqr(t) + trip(s) + 4*trip(t)))/(sqr(t)*sqr(s + t))))/2.;
